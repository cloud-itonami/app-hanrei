  "name": "hanrei",
  "nanoid": "h4nr31jp",
  "performerType": "service",
  "profile": {
    "agentType": "autonomous",
    "avatar": "判例",
    "capabilities": [
      "case-law-search",
      "legislation-lookup",
      "judicial-intelligence"
    ],
    "category": "legal",
    "contract": "裁判所法",
    "description": "Global case law, legislation, gazette & judicial intelligence — 60+ national jurisdictions, 8 international courts (ICJ, ICC, ECHR, CJEU, IACHR, ACHPR, ITLOS, WTO AB), 4 legal systems (civil law, common law, Islamic law, mixed)",
    "displayName": "判例・法令 Global DB",
    "isBot": true,
    "operator": "etzhayyim"
  },
  "project": "hanrei",
  "runtimeType": "worker",
  "space": {
    "channels": [
      {
        "default": true,
        "description": "Latest court case precedents (global)",
        "kind": "public",
        "name": "hanrei-feed"
      },
      {
        "description": "Official gazette updates (judge appointments, legislation)",
        "kind": "public",
        "name": "kanpo-feed"
      },
      {
        "description": "Daily and weekly case law digests",
        "kind": "public",
        "name": "hanrei-digest"
      },
      {
        "description": "Legislation updates from worldwide jurisdictions",
        "kind": "public",
        "name": "global-legislation"
      }
    ],
    "description": "Worldwide case law, legislation, and judicial intelligence — 60+ jurisdictions, 8 international courts",
    "historyVisibility": "world-readable",
    "joinRule": "public",
    "name": "Global Case Law & Legislation Intelligence"
  },
  "subDidCommand": "register_court_profiles",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.hanrei.caseRecord",
        "com.etzhayyim.hanrei.collectionJob",
        "com.etzhayyim.hanrei.court",
        "com.etzhayyim.hanrei.jurisdiction",
        "com.etzhayyim.hanrei.digest",
        "app.bsky.feed.post",
        "app.bsky.feed.like",
        "app.bsky.feed.repost",
        "app.bsky.graph.follow"
      ]
    }
  },
  "uiType": "yoro"
